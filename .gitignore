# --- 密钥 / 本地配置（绝不入库） ---
.env
.env.*
!.env.example
*.local.json
*.local.toml
secrets/
.secrets/
credentials/
.credentials/

# 本地实际使用的配置（随仓库提供的是 config.example.toml）
config/config.toml

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- 本地数据（Screenpipe 已负责存储原始活动，本项目 DB 只存干预记录） ---
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
data/
*.parquet

# --- Pipe 运行期日志（只在本机累积，不入库） ---
pipes/*/runs.jsonl
pipes/*/interventions.jsonl

# --- 日志 / 运行产物 ---
*.log
logs/
out/
tmp/

# --- 编辑器 / 操作系统 ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.swp
.DS_Store
Thumbs.db
desktop.ini
