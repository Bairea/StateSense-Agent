# --- 密钥 / 本地配置（绝不入库） ---
.env
.env.*
!.env.example
*.local.json
*.local.toml
secrets/
.secrets/
credentials/
.credentials/

# 本地实际使用的配置（随仓库提供的是 config.example.toml）
config/config.toml

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- 本地数据（Screenpipe 已负责存储原始活动，本项目 DB 只存干预记录） ---
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
data/
*.parquet

# --- Pipe 运行期日志（只在本机累积，不入库） ---
pipes/*/runs.jsonl
pipes/*/interventions.jsonl

# --- 日志 / 运行产物 ---
*.log
logs/
out/
tmp/

# --- 审查 / 调试用的临时转储 ---
# 踩过：审查子代理把 1748 行 diff 转储写进仓库，被 `git add -A` 扫进了提交。
# 兜底一条规则，并请优先用显式路径而不是 `git add -A`。
.review_*
.scratch_*
*_diff.txt

# --- 智能体工作区 ---
# 里面是本机的会话记录与长期记忆（含本机绝对路径），属于「本地状态」而不是项目内容，
# 与 config/config.toml 同一性质：留在本机，不入库。
.workbuddy/

# --- 编辑器 / 操作系统 ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.swp
.DS_Store
Thumbs.db
desktop.ini
